# Copy to .env and fill in real values. Never commit the real .env file.

# ---- PostgreSQL (docker-compose) ----
POSTGRES_DB=assignment_submission_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5434

# ---- Backend (ASP.NET Core / docker-compose) ----
# ASPNETCORE_ENVIRONMENT + Jwt__* feed the `api` service directly in docker-compose.yml.
# ConnectionStrings__Default below is for running the API outside Docker (dotnet run);
# inside docker-compose the api service builds its own Host=postgres connection string.
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5000
ConnectionStrings__Default=Host=localhost;Port=5434;Database=assignment_submission_dev;Username=postgres;Password=change_me
Jwt__Key=replace_with_a_random_32+_char_secret
Jwt__Issuer=AssignmentSubmissionSystem
Jwt__Audience=AssignmentSubmissionSystem.Client
Jwt__ExpiryMinutes=60

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
