# Copy to .env and fill in real values. Never commit the real .env file.

# ---- PostgreSQL (docker-compose) ----
POSTGRES_DB=assignment_submission_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5434

# ---- Backend (ASP.NET Core / docker-compose) ----
# ASPNETCORE_ENVIRONMENT + Jwt__* feed the `api` service directly in docker-compose.yml.
# ConnectionStrings__Default below is for running the API outside Docker (dotnet run);
# inside docker-compose the api service builds its own Host=postgres connection string.
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5000
ConnectionStrings__Default=Host=localhost;Port=5434;Database=assignment_submission_dev;Username=postgres;Password=change_me
Jwt__Key=replace_with_a_random_32+_char_secret
Jwt__Issuer=AssignmentSubmissionSystem
Jwt__Audience=AssignmentSubmissionSystem.Client
Jwt__ExpiryMinutes=60

# ---- File uploads ----
# Provider: Auto (default) uses Cloudinary when the three credentials below are all set and
# falls back to local disk otherwise; Cloudinary fails fast if they are missing; Local always
# writes to LocalRootPath. The resolved choice is printed in the API's startup log.
#
# Local storage is fine for evaluation but is container-local: without the `uploads` volume in
# docker-compose.yml, files disappear when the container is recreated.
Storage__Provider=Auto
Storage__MaxFileSizeBytes=10485760
Storage__MaxFilesPerOwner=5
Storage__LocalRootPath=/app/uploads

# From the Cloudinary dashboard. ApiSecret is a credential — keep it out of version control.
# Uploads are stored as `raw` assets with delivery type `authenticated`, so they are not
# publicly readable by URL; downloads are proxied through the API's own authorization checks.
Storage__Cloudinary__CloudName=
Storage__Cloudinary__ApiKey=
Storage__Cloudinary__ApiSecret=
Storage__Cloudinary__Folder=assignment-submission

# ---- Deadline reminder worker ----
# Notifies students who have not submitted when a deadline is within LeadTimeHours. Each
# student is reminded once per assignment, enforced by a unique index rather than by state in
# the worker, so running more than one replica cannot double-notify.
Notifications__DeadlineReminder__Enabled=true
Notifications__DeadlineReminder__ScanIntervalMinutes=30
Notifications__DeadlineReminder__LeadTimeHours=24

# ---- Login rate limiting ----
# Fixed window per client IP on POST /auth/login. Defaults if unset: 10 requests / 60s.
RateLimiting__Login__PermitLimit=10
RateLimiting__Login__WindowSeconds=60

# ---- Frontend (Next.js) ----
# Baked into the browser bundle when the frontend image is built, so it must be the URL the
# browser can reach (the published API_PORT), not the compose service name.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# Published host port. Change this if 3000 is already taken on your machine, and keep the
# FRONTEND_ORIGIN values below in sync — the container itself always listens on 3000.
FRONTEND_PORT=3000

# Browser origin(s) allowed by the API CORS policy. Must match FRONTEND_PORT above.
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_ORIGIN_ALT=http://127.0.0.1:3000
