# Copy to .env.local for local development. Never commit the real file.
# Only NEXT_PUBLIC_* variables are exposed to the browser — do not put secrets here.

# Base URL of the ASP.NET Core API, including the /api/v1 prefix.
# Must match the API_PORT used by backend/docker-compose.yml (default 5000).
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
